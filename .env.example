# ICMR STW AI Environment Configuration Template
# Copy this file to .env to override defaults

# Base paths (defaults to current project root)
# ICMR_DATA_DIR=data
# ICMR_CONFIG_PATH=config/settings.yaml

# Network settings
# ICMR_REQUEST_TIMEOUT=30
# ICMR_MAX_RETRIES=3

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Phase 5 — LLM / SLM Provider Settings
# Options: local | gemini | openai
LLM_PROVIDER=local
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# API Keys (leave blank for local deterministic provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# RAG Pipeline Settings
RAG_TOP_K=5
MIN_RETRIEVAL_SCORE=0.01
ENABLE_GROUNDING_VALIDATION=true
ENABLE_PROMPT_INJECTION_DEFENSE=true

{
  "base_model": "microsoft/Phi-3.5-mini-instruct",
  "dataset_version": "v1.0-icmr-approved",
  "max_seq_length": 2048,
  "learning_rate": 0.0002,
  "batch_size": 2,
  "gradient_accumulation_steps": 4,
  "num_epochs": 3,
  "warmup_ratio": 0.05,
  "weight_decay": 0.01,
  "lora_rank": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.05,
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj"
  ],
  "bias": "none",
  "task_type": "CAUSAL_LM",
  "quantization": "4bit",
  "mixed_precision": "fp16",
  "seed": 42,
  "train_dataset_path": "data/evaluation/train.json",
  "val_dataset_path": "data/evaluation/validation.json",
  "output_dir": "data/training/runs"
}
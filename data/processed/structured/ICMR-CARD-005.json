  "clinical_presentation": {
    "definition": "Clinical presentation and diagnostic characteristics of Stable Angina per ICMR STW.",
    "typical_symptoms": [
      "Diffuse retrosternal pain,",
      "heaviness or constriction,",
      "radiating to arms or neck",
      "or back",
      "Associated with sweating",
      "Easily reproduced with",
      "post-meal exertion",
      "presentation: Exertional",
      "fatigue or breathlessness",
      "or profuse sweating or"
    ],
    "atypical_presentations": [
      "Consider atypical"
    ],
    "signs_and_physical_exam": [],
    "unlikely_features": [
      "Variable location or",
      "characteristic",
      "Long lasting (hours to days)",
      "or short lasting (less than a",
      "minute)",
      "Restricted to areas above jaw",
      "or below epigastrium",
      "Localized to a point"
    ],
    "red_flags": [
      "Angina at rest or lasting more than 20 minutes",
      "Recent worsening of stable angina (crescendo) to",
      "CCS class III",
      "New onset effort angina of less than 1 month in",
      "CCS class II/ III",
      "Post infarction angina"
    ],
    "source": {
      "document_id": "ICMR-CARD-005",
      "document_name": "Stable Angina",
      "page_number": 1,
      "section": "CLINICAL PRESENTATION",
      "source_text_reference": "CONSIDER ANGINA IF\n• Diffuse retrosternal pain,\nheaviness or constriction,\nradiating to arms or neck\nor back\n• Associated with sweating\n• Easily reproduced with\npost-meal exertion\n• Consider atypical\npresentation: Exertional\nfatigue or breathlessness\nor profuse sweating or\nepigastric discomfort\nLikelihood more if known\npatient of CAD\nANGINA UNLIKELY IF\n• Variable location or\ncharacteristic\n• Long lasting (hours to days)\nor short lasting (less than a\nminute)\n• Restricted to areas above jaw\nor below epigastrium\n• Localized to a point\n• Pricking or piercing or\nstabbing type of pain\n• Precipitated by movement\nof neck or arms or\nrespiration\nACUTE CORONARY SYNDROME\n• Angina at rest or lasting more than 20 minutes\n• Recent worsening of stable angina (crescendo) to\nCCS class III\n• New onset effort angina of less than 1 month in\nCCS class II/ III\n• Post infarction angina\nFor management: refer to STEMI/ NSTEMI STW\nCATEGORIZE ANGINA",
      "bounding_box": null,
      "extraction_type": "text",
      "review_status": "extracted",
      "requires_manual_review": false,
      "review_notes": null,
      "normalized_term": null
    }
  },
